NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://hypit:hypit@localhost:5432/hypit
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
CLIENT_URL=http://localhost:5173
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Free provider alternative (used when AI_API_KEY is set, instead of Anthropic):
# AI_API_KEY=
# AI_API_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=deepseek/deepseek-chat-v3.1:free
# Fallback providers, tried in order when the previous one is limited:
# AI2_API_KEY=
# AI2_API_BASE_URL=https://router.huggingface.co/v1
# AI2_MODEL=deepseek-ai/DeepSeek-V3-0324
# AI3_API_KEY=
# AI3_API_BASE_URL=https://api.x.ai/v1
# AI3_MODEL=grok-3-mini
# AI4_API_KEY=
# AI4_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI4_MODEL=gemini-3.8-flash
# AI3 is reserved for a Chinese provider, for example Zhipu GLM:
# AI3_API_KEY=
# AI3_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI3_MODEL=glm-4-flash
# Per provider timeout and total generation budget, in milliseconds.
# The total must stay below the 30 second Vercel function limit, so a
# slow provider returns a clean 502 instead of an empty 504.
# AI_PROVIDER_TIMEOUT_MS=10000
# AI_GENERATION_TIMEOUT_MS=25000
# AI5 is reserved for NVIDIA NIM, for example a Chinese model hosted there:
# AI5_API_KEY=
# AI5_API_BASE_URL=https://integrate.api.nvidia.com/v1
# AI5_MODEL=zai-org/GLM-4.6
