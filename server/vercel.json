{
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && npx tsc -p tsconfig.json",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/v1/health.ts": {
      "maxDuration": 30
    },
    "api/v1/auth/register.ts": {
      "maxDuration": 30
    },
    "api/v1/auth/login.ts": {
      "maxDuration": 30
    },
    "api/v1/auth/refresh.ts": {
      "maxDuration": 30
    },
    "api/v1/auth/logout.ts": {
      "maxDuration": 30
    },
    "api/v1/projects/index.ts": {
      "maxDuration": 30
    },
    "api/v1/projects/[id].ts": {
      "maxDuration": 30
    },
    "api/v1/projects/[id]/generate.ts": {
      "maxDuration": 30
    },
    "api/v1/projects/[id]/scenes.ts": {
      "maxDuration": 30
    }
  }
}
